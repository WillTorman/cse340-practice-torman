<%- include('../partials/header') %>
<main>
    <h1><%= course.courseCode %>: <%= course.name %></h1>

    <section class="course-summary">
        <p><strong>Department:</strong> <%= course.department %></p>
        <p><strong>Credits:</strong> <%= course.creditHours %></p>
        <p><%= course.description %></p>
    </section>

    <section class="section-sorting">
        <h2>Sections</h2>
        <p>
            Sort by:
            <a href="/catalog/<%= course.slug %>" class="<%= currentSort === 'time' ? 'active' : '' %>">Time</a> |
            <a href="/catalog/<%= course.slug %>?sort=professor" class="<%= currentSort === 'professor' ? 'active' : '' %>">Professor</a> |
            <a href="/catalog/<%= course.slug %>?sort=room" class="<%= currentSort === 'room' ? 'active' : '' %>">Room</a>
        </p>
    </section>

    <table>
        <thead>
            <tr>
                <th>Time</th>
                <th>Room</th>
                <th>Professor</th>
            </tr>
        </thead>
        <tbody>
            <% if (sections.length === 0) { %>
                <tr>
                    <td colspan="3">No sections available.</td>
                </tr>
            <% } else { %>
                <% sections.forEach((section) => { %>
                    <tr>
                        <td><%= section.time %></td>
                        <td><%= section.room %></td>
                        <td><%= section.professor %></td>
                    </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>
</main>
<%- include('../partials/footer') %>